#!/usr/bin/env zsh
# claude-local: launch Claude Code with MCPs configured locally or globally.
#
# Data structure:
#   ~/.claude-mcp-data/
#   ├── _global/              <- shared across all projects
#   │   ├── cbm/
#   │   └── headroom/memory.db
#   └── <project-name>/       <- one folder per project
#       ├── cbm/
#       └── headroom/memory.db

set -e

# --- Parse --work / --personal flag before interactive prompts ---------------
CLAUDE_CONFIG_DIR="$HOME/.claude"
_new_args=()
for _arg in "$@"; do
  case "$_arg" in
    --work)     CLAUDE_CONFIG_DIR="$HOME/.claude-work" ;;
    --personal) CLAUDE_CONFIG_DIR="$HOME/.claude" ;;
    *)          _new_args+=("$_arg") ;;
  esac
done
set -- "${_new_args[@]}"
export CLAUDE_CONFIG_DIR

BASE_DIR="$HOME/.claude-mcp-data"

CBM_UI_BASE_PORT="${CBM_UI_BASE_PORT:-9749}"
CBM_BIN="${CBM_BIN:-$HOME/.local/bin/codebase-memory-mcp}"
AGENT_MONITOR_PORT="${AGENT_MONITOR_PORT:-4820}"

find_free_port() {
  local p=$1
  while lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; do
    p=$((p + 1))
  done
  print -- "$p"
}

CBM_UI_PORT="$(find_free_port "$CBM_UI_BASE_PORT")"
CBM_UI_URL="http://localhost:${CBM_UI_PORT}"
AGENT_MONITOR_URL="http://localhost:${AGENT_MONITOR_PORT}"

# --- Require gum for wizard UI ---------------------------------------------
if ! command -v gum >/dev/null 2>&1; then
  print "gum is required for this script. Install with:"
  print "  brew install charmbracelet/tap/gum"
  exit 1
fi

# --- Profile label -----------------------------------------------------------
if [[ "$CLAUDE_CONFIG_DIR" == "$HOME/.claude-work" ]]; then
  profile_label="WORK"
else
  profile_label="PERSONAL"
fi

# --- Wizard header -----------------------------------------------------------
clear
gum style \
  --border rounded \
  --border-foreground 99 \
  --padding "1 4" \
  --margin "1 2" \
  --bold \
  "🤖  claude-local  ·  profile: ${profile_label}  ·  project: $(basename "$PWD")"

# --- 1. Use Headroom? --------------------------------------------------------
use_headroom=$(gum choose \
  --header "🪄  Use Headroom?" \
  --cursor "❯ " \
  --cursor.foreground 212 \
  --selected.foreground 212 \
  "Yes" "No")

# --- 2. Local or global scope? -----------------------------------------------
scope=$(gum choose \
  --header "📁  Data scope?" \
  --cursor "❯ " \
  --cursor.foreground 75 \
  --selected.foreground 75 \
  "Local  (this project: $(basename "$PWD"))" "Global  (shared across all projects)")

# --- 3. Skip permissions? ----------------------------------------------------
skip_perms=$(gum choose \
  --header "🔓  Skip permission prompts?" \
  --cursor "❯ " \
  --cursor.foreground 214 \
  --selected.foreground 214 \
  "Yes  (dangerously-skip-permissions)" "No  (safe, default)")

# --- Resolve scope -----------------------------------------------------------
case "$scope" in
  Local*)
    project_name="${PWD##*/}"
    data_dir="$BASE_DIR/$project_name"
    scope_label="local ($project_name)"
    ;;
  Global*)
    data_dir="$BASE_DIR/_global"
    scope_label="global"
    ;;
esac

# --- Resolve claude flags ----------------------------------------------------
claude_flags=()
case "$skip_perms" in
  Yes*) claude_flags+=("--dangerously-skip-permissions"); skip_label="ON" ;;
  No*)  skip_label="OFF" ;;
esac

# --- Create directories ------------------------------------------------------
mkdir -p "$data_dir/cbm" "$data_dir/headroom"

# --- Export env vars ---------------------------------------------------------
export CBM_DATA_DIR="$data_dir/cbm"
export HEADROOM_DB_PATH="$data_dir/headroom/memory.db"

if [[ -x "$CBM_BIN" ]]; then
  "$CBM_BIN" config set port "$CBM_UI_PORT" >/dev/null 2>&1 || true
fi
export CBM_UI_PORT

# --- Summary card ------------------------------------------------------------
echo ""
gum style \
  --border normal \
  --border-foreground 240 \
  --padding "0 2" \
  --margin "0 2" \
  "$(gum style --foreground 245 '👤 Profile:    ')$(gum style --bold --foreground 220 "$profile_label")
$(gum style --foreground 245 '🎯 Scope:      ')$(gum style --bold --foreground 75 "$scope_label")
$(gum style --foreground 245 '🔓 Skip perms: ')$(gum style --bold --foreground 214 "$skip_label")
$(gum style --foreground 245 '🪄 Headroom:   ')$(gum style --bold --foreground 212 "$use_headroom")
$(gum style --foreground 245 '🌐 Graph UI:   ')$(gum style --foreground 75 "$CBM_UI_URL")
$(gum style --foreground 245 '📊 Monitor:    ')$(gum style --foreground 75 "$AGENT_MONITOR_URL")"

if [[ "$CBM_UI_PORT" != "$CBM_UI_BASE_PORT" ]]; then
  echo ""
  gum style --foreground 245 --margin "0 2" \
    "  (port $CBM_UI_BASE_PORT busy — this session uses $CBM_UI_PORT)"
fi

echo ""

# --- Launch ------------------------------------------------------------------
case "$use_headroom" in
  Yes)
    gum style --bold --foreground 82 --margin "0 2" "🚀 Launching Claude Code with Headroom..."
    echo ""
    headroom wrap claude --memory --code-graph --no-serena -- "${claude_flags[@]}" "$@"
    ;;
  No)
    gum style --bold --foreground 82 --margin "0 2" "🚀 Launching Claude Code..."
    echo ""
    claude "${claude_flags[@]}" "$@"
    ;;
esac
