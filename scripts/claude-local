#!/usr/bin/env zsh
# claude-local: launch Claude Code with MCPs configured locally or globally.
#
# Data structure:
#   ~/.claude-mcp-data/
#   ├── _global/              <- shared across all projects
#   │   ├── cbm/
#   │   └── headroom/memory.db
#   └── <project-name>/       <- one folder per project
#       ├── cbm/
#       └── headroom/memory.db

set -e

BASE_DIR="$HOME/.claude-mcp-data"

# --- Colors (ANSI) ---------------------------------------------------------
if [[ -t 1 ]]; then
  RESET=$'\e[0m'; BOLD=$'\e[1m'; DIM=$'\e[2m'
  RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'
  BLUE=$'\e[34m'; MAGENTA=$'\e[35m'; CYAN=$'\e[36m'; GREY=$'\e[90m'
else
  RESET=""; BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""
  BLUE=""; MAGENTA=""; CYAN=""; GREY=""
fi

ask() { print -n "${BOLD}${CYAN}❯ ${RESET}"; }
err() { print "${RED}✖ $1${RESET}"; exit 1; }

# --- 1. Use Headroom? ------------------------------------------------------
print ""
print "${BOLD}${MAGENTA}🪄  Do you want to use Headroom?${RESET}"
print "  ${GREEN}1)${RESET} Yes"
print "  ${RED}2)${RESET} No"
ask
read use_headroom

# --- 2. Local or global scope? ---------------------------------------------
print ""
print "${BOLD}${BLUE}📁  Which data scope?${RESET}"
print "  ${GREEN}1)${RESET} Local   ${DIM}(this project: $(basename "$PWD"))${RESET}"
print "  ${GREEN}2)${RESET} Global  ${DIM}(shared across all projects)${RESET}"
ask
read scope

# --- 3. Skip permissions? --------------------------------------------------
print ""
print "${BOLD}${YELLOW}🔓  Run with --dangerously-skip-permissions?${RESET}"
print "  ${YELLOW}1)${RESET} Yes  ${DIM}(no permission prompts -- use with caution)${RESET}"
print "  ${GREEN}2)${RESET} No   ${DIM}(default, safe)${RESET}"
ask
read skip_perms

# --- 4. Resolve data directory ---------------------------------------------
case "$scope" in
  1)
    project_name="${PWD##*/}"
    data_dir="$BASE_DIR/$project_name"
    scope_label="${CYAN}LOCAL${RESET} ${DIM}($project_name)${RESET}"
    ;;
  2)
    data_dir="$BASE_DIR/_global"
    scope_label="${MAGENTA}GLOBAL${RESET}"
    ;;
  *)
    err "Invalid option. Exiting."
    ;;
esac

# --- 5. Resolve claude flags -----------------------------------------------
claude_flags=()
case "$skip_perms" in
  1)
    claude_flags+=("--dangerously-skip-permissions")
    skip_label="${YELLOW}ON${RESET}"
    ;;
  2)
    skip_label="${GREEN}OFF${RESET}"
    ;;
  *)
    err "Invalid option. Exiting."
    ;;
esac

# --- 6. Create directories if missing --------------------------------------
mkdir -p "$data_dir/cbm" "$data_dir/headroom"

# --- 7. Export env vars for the MCPs ---------------------------------------
export CBM_DATA_DIR="$data_dir/cbm"
export HEADROOM_DB_PATH="$data_dir/headroom/memory.db"

# --- 8. Print config and launch --------------------------------------------
print ""
print "${GREY}─────────────────────────────────────────${RESET}"
print "  ${BOLD}🎯 Scope:${RESET}        $scope_label"
print "  ${BOLD}🧠 CBM data:${RESET}     ${DIM}$CBM_DATA_DIR${RESET}"
print "  ${BOLD}💾 Headroom DB:${RESET}  ${DIM}$HEADROOM_DB_PATH${RESET}"
print "  ${BOLD}🔓 Skip perms:${RESET}   $skip_label"

case "$use_headroom" in
  1)
    print "  ${BOLD}🪄 Headroom:${RESET}     ${GREEN}ON ${DIM}(wrap)${RESET}"
    print "${GREY}─────────────────────────────────────────${RESET}"
    print ""
    print "${GREEN}🚀 Launching Claude Code with Headroom...${RESET}"
    print ""
    # --memory + --code-graph + --no-serena are Headroom flags (go BEFORE the
    # --); everything after -- is passed through to claude.
    # --no-serena: don't auto-register the Serena MCP (not used in this setup).
    headroom wrap claude --memory --code-graph --no-serena -- "${claude_flags[@]}" "$@"
    ;;
  2)
    print "  ${BOLD}🪄 Headroom:${RESET}     ${RED}OFF${RESET}"
    print "${GREY}─────────────────────────────────────────${RESET}"
    print ""
    print "${GREEN}🚀 Launching Claude Code...${RESET}"
    print ""
    claude "${claude_flags[@]}" "$@"
    ;;
  *)
    err "Invalid Headroom option. Exiting."
    ;;
esac
